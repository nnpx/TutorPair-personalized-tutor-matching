{
  "family": "tutorpair-pilot-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::528301714999:role/tutorpair-pilot-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::528301714999:role/tutorpair-pilot-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "528301714999.dkr.ecr.ap-southeast-1.amazonaws.com/tutorpair-pilot-api@sha256:3ba1d4a1d2c634c6c66d0997e2845f55c3afbcf5e88bbb72bf13f8f445e92f1c",
      "essential": true,
      "portMappings": [
        { "containerPort": 4000, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "PORT", "value": "4000" },
        { "name": "NODE_ENV", "value": "production" },
        { "name": "DB_POOL_MAX", "value": "5" },
        { "name": "RDS_CA_BUNDLE", "value": "/app/rds-ap-southeast-1-bundle.pem" },
        { "name": "AWS_REGION", "value": "ap-southeast-1" },
        { "name": "ALLOWED_ORIGIN", "value": "https://pilot.ddn2qrfc4g8y1.amplifyapp.com" },
        { "name": "TUTOR_PORTAL_URL", "value": "https://pilot.ddn2qrfc4g8y1.amplifyapp.com/tutor/profile" },
        { "name": "COGNITO_USER_POOL_ID", "value": "ap-southeast-1_sYIuVgJx5" },
        { "name": "COGNITO_CLIENT_ID", "value": "irch38183ksbnqcgabscq78oo" },
        { "name": "S3_BUCKET_NAME", "value": "tutorpair-pilot-documents-528301714999-ap-southeast-1-an" },
        { "name": "EMAIL_MODE", "value": "ses" },
        { "name": "SES_FROM_EMAIL", "value": "tutorpair.admin@gmail.com" }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:528301714999:secret:tutorpair/pilot/api/database-url-DngwHK:tutorpair/pilot/api/database-url::"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget --no-verbose --tries=1 --spider http://localhost:4000/api/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/tutorpair-pilot-api",
          "awslogs-region": "ap-southeast-1",
          "awslogs-stream-prefix": "api"
        }
      }
    }
  ]
}
