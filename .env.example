# ==============================================================================
# TutorPair Environment Variables Template
# Copy this file to .env.local in apps/server/ and apps/client/
# ==============================================================================

# Server Environment
PORT=4000
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:5173

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tutorpair

# AWS Common Configuration
AWS_REGION=ap-southeast-1

# AWS Cognito (Authentication)
COGNITO_USER_POOL_ID=ap-southeast-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Amazon S3 (Document & Photo Storage)
S3_BUCKET_NAME=tutorpair-documents-dev

# Amazon SES (Email Notifications)
SES_FROM_EMAIL=notifications@tutorpair.com

# Client (Vite) Environment Variables (prefix with VITE_)
VITE_API_BASE_URL=http://localhost:4000
VITE_AWS_REGION=ap-southeast-1
VITE_COGNITO_USER_POOL_ID=ap-southeast-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Email mode: disabled (default), preview (local files), ses (actual AWS delivery)
EMAIL_MODE=disabled
EMAIL_PREVIEW_DIR=work/email-preview
TUTOR_PORTAL_URL=http://localhost:5180/tutor/profile

# For cloud delivery ONLY, configure EMAIL_MODE=ses plus a verified SES_FROM_EMAIL,
# AWS_REGION, IAM credentials/task role, and an HTTPS TUTOR_PORTAL_URL.
# Keep EMAIL_MODE=preview for local testing; no cloud credentials are needed.
