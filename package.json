{
  "name": "tutorpair-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "TutorPair Cloud Platform Monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@tutorpair/shared && npm run build --workspace=server && npm run build --workspace=client",
    "build:shared": "npm run build --workspace=@tutorpair/shared",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "db:generate": "npm run db:generate --workspace=server",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:seed": "npm run db:seed --workspace=server",
    "db:studio": "npm run db:studio --workspace=server",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "drizzle-orm": "^0.45.4",
    "typescript": "^5.4.5"
  }
}
